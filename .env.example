# Django
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Superuser bootstrap (optional)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeMeNow123!
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

# Production PostgreSQL
POSTGRES_DB=analytics_edu
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQL sandbox PostgreSQL — MUST be a separate database
SANDBOX_DB=sql_sandbox
SANDBOX_USER=sandbox_reader
SANDBOX_PASSWORD=change-me-sandbox-password
SANDBOX_HOST=sandbox-db
SANDBOX_PORT=5432
SANDBOX_ADMIN_USER=sandbox_admin
SANDBOX_ADMIN_PASSWORD=change-me-sandbox-admin-password
SANDBOX_QUERY_TIMEOUT_SECONDS=5
SANDBOX_MAX_ROWS=200
SANDBOX_MAX_QUERY_CHARS=8000

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Uploads
MAX_HOMEWORK_UPLOAD_MB=1

# Google OAuth (create a Web client in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/

# Telegram bot (same Django database / users)
TELEGRAM_BOT_TOKEN=
