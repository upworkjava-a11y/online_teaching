# Copy to .env on PythonAnywhere (never commit the real file).
# Path example: /home/YOUR_USERNAME/My-online-platform/.env

SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.pythonanywhere

# Replace YOUR_USERNAME
ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com,.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://YOUR_USERNAME.pythonanywhere.com

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# SQLite is default (recommended for first deploy + free tier).
# Set to 1 only after you create a MySQL DB in the PA dashboard.
PYTHONANYWHERE_USE_MYSQL=0
# MYSQL_DATABASE=YOUR_USERNAME$analytics
# MYSQL_USER=YOUR_USERNAME
# MYSQL_PASSWORD=
# MYSQL_HOST=YOUR_USERNAME.mysql.pythonanywhere-services.com

SERVE_MEDIA=True
MAX_HOMEWORK_UPLOAD_MB=1

# Optional — leave empty on free PA
REDIS_URL=

# Bootstrap admin (first run only)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeMeNow123!
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

# Google OAuth — add your live domain in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_USERNAME.pythonanywhere.com/accounts/google/callback/

TELEGRAM_BOT_TOKEN=
